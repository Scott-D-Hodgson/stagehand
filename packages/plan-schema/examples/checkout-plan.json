{
  "schemaVersion": 1,
  "id": "checkout-plan",
  "defaults": {
    "locale": "en-CA",
    "browser": {
      "type": "chromium",
      "headless": true,
      "viewport": {
        "width": 1280,
        "height": 720
      },
      "timeZone": "America/Toronto"
    },
    "accessibility": {
      "enabled": true,
      "tags": ["wcag2a", "wcag2aa"]
    }
  },
  "variables": {
    "baseUrl": "http://localhost:3000"
  },
  "cases": [
    {
      "path": "cases/sign-in.json"
    }
  ]
}
