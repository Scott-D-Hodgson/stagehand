{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stagehand case, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "settings": { "$ref": "#/$defs/caseSettings" },
    "variables": { "$ref": "#/$defs/variables" },
    "dataSets": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataSet" }
    },
    "defaultDataSet": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/navigateStep" },
          { "$ref": "#/$defs/clickStep" },
          { "$ref": "#/$defs/typeStep" },
          { "$ref": "#/$defs/fillStep" },
          { "$ref": "#/$defs/selectOptionStep" },
          { "$ref": "#/$defs/assertTextStep" },
          { "$ref": "#/$defs/assertHtmlStep" },
          { "$ref": "#/$defs/assertValueStep" }
        ]
      }
    }
  },
  "$defs": {
    "variables": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/variableDefinition" }
    },
    "dataSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "variables"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "variables": { "$ref": "#/$defs/variables" }
      }
    },
    "variableDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/textVariableDefinition" },
        { "$ref": "#/$defs/numberVariableDefinition" },
        { "$ref": "#/$defs/booleanVariableDefinition" }
      ]
    },
    "textVariableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "type": "string" },
        "locales": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "numberVariableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "type": "number" },
        "locales": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "booleanVariableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "type": "boolean" },
        "locales": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "default": 30000
    },
    "stepTimeout": {
      "type": "object",
      "properties": {
        "timeout": { "$ref": "#/$defs/timeout" },
        "variables": { "$ref": "#/$defs/variables" }
      }
    },
    "interactionStep": {
      "allOf": [
        { "$ref": "#/$defs/stepTimeout" },
        {
          "type": "object",
          "properties": {
            "before": { "$ref": "#/$defs/waitList" },
            "after": { "$ref": "#/$defs/waitList" },
            "scrollIntoView": { "type": "boolean", "default": true }
          }
        }
      ]
    },
    "locatorWait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waitFor"],
      "properties": {
        "waitFor": { "$ref": "#/$defs/locator" },
        "timeout": { "$ref": "#/$defs/timeout" }
      }
    },
    "stateWait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waitForState"],
      "properties": {
        "waitForState": { "enum": ["domcontentloaded", "networkidle"] },
        "timeout": { "$ref": "#/$defs/timeout" }
      }
    },
    "delayWait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delay"],
      "properties": {
        "delay": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "timeout": { "$ref": "#/$defs/timeout" }
      }
    },
    "waitList": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/locatorWait" },
          { "$ref": "#/$defs/stateWait" },
          { "$ref": "#/$defs/delayWait" }
        ]
      }
    },
    "expectedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "$ref": "#/$defs/textOrVariableReference" },
        "locales": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/textOrVariableReference" }
        }
      }
    },
    "variableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["var"],
      "properties": {
        "var": { "type": "string", "minLength": 1 }
      }
    },
    "textOrVariableReference": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/variableReference" }
      ]
    },
    "navigateStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/stepTimeout" },
        {
          "type": "object",
          "required": ["action", "url"],
          "properties": {
            "action": { "const": "navigate" },
            "url": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
                },
                { "$ref": "#/$defs/variableReference" }
              ]
            },
            "waitUntil": {
              "enum": ["domcontentloaded", "networkidle"],
              "default": "domcontentloaded"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "clickStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/interactionStep" },
        {
          "type": "object",
          "required": ["action", "locator"],
          "properties": {
            "action": { "const": "click" },
            "locator": { "$ref": "#/$defs/locator" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "typeStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/interactionStep" },
        {
          "type": "object",
          "required": ["action", "locator", "text"],
          "properties": {
            "action": { "const": "type" },
            "locator": { "$ref": "#/$defs/locator" },
            "text": { "$ref": "#/$defs/textOrVariableReference" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "fillStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/interactionStep" },
        {
          "type": "object",
          "required": ["action", "locator", "value"],
          "properties": {
            "action": { "const": "fill" },
            "locator": { "$ref": "#/$defs/locator" },
            "value": { "$ref": "#/$defs/textOrVariableReference" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "selectOptionStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/interactionStep" },
        {
          "type": "object",
          "required": ["action", "locator"],
          "properties": {
            "action": { "const": "selectOption" },
            "locator": { "$ref": "#/$defs/locator" },
            "value": { "$ref": "#/$defs/textOrVariableReference" },
            "label": { "$ref": "#/$defs/textOrVariableReference" }
          },
          "oneOf": [
            { "required": ["value"], "not": { "required": ["label"] } },
            { "required": ["label"], "not": { "required": ["value"] } }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "assertionStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/stepTimeout" },
        {
          "type": "object",
          "properties": {
            "locator": { "$ref": "#/$defs/locator" },
            "expected": { "$ref": "#/$defs/expectedValue" },
            "soft": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "assertTextStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/assertionStep" },
        {
          "type": "object",
          "required": ["action", "locator", "expected"],
          "properties": { "action": { "const": "assertText" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "assertHtmlStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/assertionStep" },
        {
          "type": "object",
          "required": ["action", "locator", "expected"],
          "properties": { "action": { "const": "assertHtml" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "assertValueStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/assertionStep" },
        {
          "type": "object",
          "required": ["action", "locator", "expected"],
          "properties": {
            "action": { "const": "assertValue" },
            "associatedLabel": { "$ref": "#/$defs/expectedValue" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["css"],
          "properties": {
            "css": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["xpath"],
          "properties": {
            "xpath": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "caseSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browser": { "$ref": "#/$defs/browserSettings" },
        "accessibility": { "$ref": "#/$defs/accessibilitySettings" }
      }
    },
    "browserSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chromium", "default": "chromium" },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "default": 1280 },
            "height": { "type": "integer", "minimum": 1, "default": 720 }
          }
        },
        "timeZone": { "type": "string", "minLength": 1, "default": "UTC" }
      }
    },
    "accessibilitySettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "failOnViolation": { "type": "boolean", "default": false },
        "tags": {
          "type": "array",
          "description": "Exact axe-core 4.14.0 rule tags. Omission inherits the plan tag list for cases, or uses axe defaults at plan scope. An explicit empty list clears the tag filter and uses axe defaults. Non-empty case lists replace the plan list. Validation does not apply inheritance or enable scanning.",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/axeTag" }
        }
      }
    },
