{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stagehand case, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "settings": { "$ref": "#/$defs/caseSettings" },
    "variables": { "$ref": "#/$defs/variables" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "locator": { "$ref": "#/$defs/locator" }
        }
      }
    }
  },
  "$defs": {
    "variables": {
      "type": "object",
      "additionalProperties": true
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["css"],
          "properties": {
            "css": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["xpath"],
          "properties": {
            "xpath": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "caseSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browser": { "$ref": "#/$defs/browserSettings" },
        "accessibility": { "$ref": "#/$defs/accessibilitySettings" }
      }
    },
    "browserSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chromium", "default": "chromium" },
        "headless": { "type": "boolean", "default": true },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "default": 1280 },
            "height": { "type": "integer", "minimum": 1, "default": 720 }
          }
        },
        "timeZone": { "type": "string", "minLength": 1, "default": "UTC" }
      }
    },
    "accessibilitySettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
