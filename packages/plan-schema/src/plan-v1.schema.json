{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stagehand plan, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "defaults": { "$ref": "#/$defs/planDefaults" },
    "variables": { "$ref": "#/$defs/variables" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "A portable relative path using forward slashes; canonical containment is checked by the loader.",
            "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\\\]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "variables": {
      "type": "object",
      "additionalProperties": true
    },
    "planDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "minLength": 1, "default": "en-CA" },
        "browser": { "$ref": "#/$defs/browserSettings" },
        "accessibility": { "$ref": "#/$defs/accessibilitySettings" }
      }
    },
    "browserSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chromium", "default": "chromium" },
        "headless": { "type": "boolean", "default": true },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "default": 1280 },
            "height": { "type": "integer", "minimum": 1, "default": 720 }
          }
        },
        "timeZone": { "type": "string", "minLength": 1, "default": "UTC" }
      }
    },
    "accessibilitySettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "failOnViolation": { "type": "boolean", "default": false },
        "tags": {
          "type": "array",
          "description": "Exact axe-core 4.14.0 rule tags. Omission inherits the plan tag list for cases, or uses axe defaults at plan scope. An explicit empty list clears the tag filter and uses axe defaults. Non-empty case lists replace the plan list. Validation does not apply inheritance or enable scanning.",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/axeTag" }
        }
      }
    },
    "axeTag": {
      "$comment": "Inventory from axe-core 4.14.0 getRules(), including disabled rules. Refresh both standalone schemas when the pinned engine changes.",
      "type": "string",
      "enum": [
        "ACT",
        "EN-301-549",
        "EN-301-549v4",
        "EN-9.1.1.1",
        "EN-9.1.2.1",
