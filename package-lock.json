      "resolved": "packages/plan-engine",
      "link": true
    },
    "node_modules/@stagehand/plan-schema": {
      "resolved": "packages/plan-schema",
      "link": true
    },
    "node_modules/@stagehand/reporters": {
      "resolved": "packages/reporters",
      "link": true
    },
    "node_modules/@stagehand/result-model": {
      "resolved": "packages/result-model",
      "link": true
    },
    "node_modules/@stagehand/runner-core": {
      "resolved": "packages/runner-core",
      "link": true
    },
    "node_modules/@stagehand/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/plan-engine": {
      "name": "@stagehand/plan-engine",
      "version": "0.1.0"
    },
    "packages/plan-schema": {
      "name": "@stagehand/plan-schema",
      "version": "0.1.0"
    },
    "packages/reporters": {
      "name": "@stagehand/reporters",
      "version": "0.1.0"
    },
    "packages/result-model": {
      "name": "@stagehand/result-model",
      "version": "0.1.0"
    },
    "packages/runner-core": {
      "name": "@stagehand/runner-core",
      "version": "0.1.0"
    }
  }
}
