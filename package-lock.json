{
  "name": "stagehand",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "stagehand",
      "version": "0.1.0",
      "engines": {
        "node": "26.12.1",
        "npm": "11.20.0"
      },
      "workspaces": [
        "apps/cli",
        "apps/web",
        "packages/*"
      ]
    },
    "apps/cli": {
      "name": "@stagehand/cli",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@stagehand/web",
      "version": "0.1.0"
